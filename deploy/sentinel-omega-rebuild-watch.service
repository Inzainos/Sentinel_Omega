[Unit]
Description=Vigila el rebuild y sube servicios cuando termina

[Service]
Type=oneshot
ExecStart=/bin/bash /home/deamon/Sentinel_Omega/deploy/vigilar_rebuild.sh
StandardOutput=append:/home/deamon/Sentinel_Omega/sentinel_omega/logs/vigilar_rebuild.log
StandardError=append:/home/deamon/Sentinel_Omega/sentinel_omega/logs/vigilar_rebuild.log
