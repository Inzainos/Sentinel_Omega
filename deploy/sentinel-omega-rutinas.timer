[Unit]
Description=Corre las rutinas locales de Sentinel Omega cada 15 min

[Timer]
# OnCalendar (cada 15 min, reloj absoluto) en vez de OnBootSec/OnUnitActiveSec:
# el monotónico se desancleó dos veces medido (bitácora 10-19 y el incidente
# del 26-10: NextElapse=infinity/10h tras reconstruir las units). La marca en
# data/estado_digesto.json evita dobles envíos igual.
OnCalendar=*:0/15
AccuracySec=1min
Persistent=true

[Install]
# default.target y no timers.target: un gestor de USUARIO no alcanza los
# objetivos de sistema, y por eso las unidades vivían de enlaces hechos a mano.
WantedBy=default.target
