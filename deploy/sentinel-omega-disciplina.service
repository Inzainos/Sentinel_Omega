[Unit]
Description=Sentinel Omega — Disciplina Juez
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/deamon/Sentinel_Omega
EnvironmentFile=/home/deamon/.env.deamon
ExecStart=/home/deamon/.venv_unified/bin/python -m sentinel_omega.launcher --disciplina
Nice=10

# Sin [Install]: es una tarea que se corre a mano. Un `enable` la lanzaría en
# cada arranque de sesión.
