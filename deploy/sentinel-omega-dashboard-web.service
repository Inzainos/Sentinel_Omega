# Unit de USUARIO systemd -> ~/.config/systemd/user/ (sin User=/Group=).
# Nota: en vivo ExecStart apunta al npm de Windows (/mnt/c/.../hermes/node/npm);
# aqui se deja `/usr/bin/env npm` (requiere npm en el PATH del manager de usuario).
[Unit]
Description=Sentinel Omega Dashboard Web (React/Vite)
After=sentinel-omega-dashboard-api.service
Wants=sentinel-omega-dashboard-api.service

[Service]
Type=simple
WorkingDirectory=/home/deamon/Sentinel_Omega/sentinel_omega/infrastructure/dashboard/web
Environment=NODE_ENV=development
Environment=PATH=/mnt/c/Users/elanz/AppData/Local/hermes/node:/usr/bin:/bin
ExecStart=/mnt/c/Users/elanz/AppData/Local/hermes/node/npm run dev -- --host 127.0.0.1 --port 5173
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
