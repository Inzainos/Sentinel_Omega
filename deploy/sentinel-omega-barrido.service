[Unit]
Description=Sentinel Omega — Barrido diario
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/deamon/Sentinel_Omega
EnvironmentFile=/home/deamon/.env.deamon
ExecStart=/home/deamon/.venv_unified/bin/python -m sentinel_omega.launcher --barrido
Nice=10

# Sin [Install]: es una tarea que se corre a mano o desde el barrido diario.
# Un `enable` la lanzaría en cada arranque de sesión.
