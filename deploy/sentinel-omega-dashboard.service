[Unit]
Description=Sentinel Omega Dashboard (Streamlit) - acceso remoto Safari/iPad
After=network-online.target sentinel-omega.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/deamon/Sentinel_Omega
EnvironmentFile=/home/deamon/.env.deamon
ExecStart=/home/deamon/.venv_unified/bin/streamlit run sentinel_omega/infrastructure/dashboard/app.py --server.address 127.0.0.1 --server.port 8510 --server.headless true
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
