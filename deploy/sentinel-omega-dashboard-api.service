# Unit de USUARIO systemd -> ~/.config/systemd/user/ (sin User=/Group=).
[Unit]
Description=Sentinel Omega Dashboard API (FastAPI)
After=sentinel-omega.service

[Service]
Type=simple
WorkingDirectory=/home/deamon/Sentinel_Omega
EnvironmentFile=/home/deamon/.env.deamon
ExecStart=/home/deamon/.venv_unified/bin/python -m uvicorn sentinel_omega.infrastructure.dashboard.api:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
