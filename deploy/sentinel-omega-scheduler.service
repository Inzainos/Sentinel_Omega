[Unit]
Description=Sentinel Omega — Scheduler continuo
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/deamon/Sentinel_Omega
EnvironmentFile=/home/deamon/.env.deamon
ExecStart=/home/deamon/.venv_unified/bin/python -m sentinel_omega.infrastructure.pipeline.scheduler_reportes
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
